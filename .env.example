# Extraction API Environment Variables
# Copy this to .env for local development
# Add these as secrets in Railway for production

# Inbound authentication from the Estimate.ai web application. Railway
# requires signed requests by default; use the same values in Vercel.
EXTRACTION_API_KEY=replace_with_a_long_random_value
EXTRACTION_API_SIGNING_SECRET=replace_with_a_different_long_random_value
EXTRACTION_REQUIRE_SIGNED_REQUESTS=true
EXTRACTION_SIGNED_REQUEST_MAX_AGE_SECONDS=300

# Claude Vision for page classification/OCR
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Roboflow object detection
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_INFERENCE_MODE=workflow
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/infer/workflows/your-workspace/your-workflow

# OpenAI second-pass detection refinement
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REFINEMENT_MODEL=gpt-5.5
OPENAI_REFINEMENT_MAX_OUTPUT_TOKENS=12000
REFINEMENT_MAX_FACADE_OVERLAP_RATIO=0.03
REFINEMENT_CONTEXT_PAGE_TYPES=roof_plan,floor_plan
REFINEMENT_MAX_CONTEXT_PAGES=4
REFINEMENT_AUTO_ENABLED=true
REFINEMENT_AUTO_CLASSES=exterior_wall,gable
REFINEMENT_ENABLE_RETURN_PLANE_EXPANSION=false

# Use this instead of ROBOFLOW_WORKFLOW_URL when running a single hosted
# object-detection model, especially after moving to a Public/free workspace.
# Format: project-name/version
ROBOFLOW_MODEL_ID=your-public-model/1

# Cost/scope controls
ROBOFLOW_PAGE_TYPES=elevation
ROBOFLOW_ALLOWED_CLASSES=window,door,garage,building,exterior_wall,roof,gable
ROBOFLOW_CONFIDENCE=0.40
ROBOFLOW_OVERLAP=0.30
ROBOFLOW_MAX_DETECTIONS=300

# Supabase (optional, for direct database access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_key

# Port (Railway sets this automatically)
PORT=5050
